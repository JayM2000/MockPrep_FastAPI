# Environment
ENVIRONMENT=development
PROJECT_NAME="MockPrep AI Service"
VERSION="0.1.0"

# Server
HOST=127.0.0.1
PORT=8000

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:4000"]

# Internal Service-to-Service Security
INTERNAL_SERVICE_TOKEN=your-internal-service-token-here

# Database (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://user:password@host/neondb
